# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#using-environment-variables

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server and MongoDB (Preview).
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="mongodb://localhost:27018/flights?replicaSet=rs0&directConnection=true"



AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Provider de voos e hotéis: fake (padrão) ou real (dreams-amadeus contra a API)
AMADEUS_MODE=fake
# Semente do faker para resultados repetíveis (opcional)
#FAKER_SEED=42

# Endereço do servidor gRPC do serviço
GRPC_ADDRESS="0.0.0.0:50053"
# Porta do servidor HTTP com /health (e rotas de HTTP do serviço)
HTTP_PORT=3332
# Nível de log do pino: trace, debug, info, warn, error, fatal (padrão: debug em dev, info em production)
LOG_LEVEL="debug"
# Tempo máximo de cada verificação do /health, em ms (padrão 2000)
HEALTH_CHECK_TIMEOUT_MS=2000
