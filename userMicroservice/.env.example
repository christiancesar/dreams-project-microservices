# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#using-environment-variables

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server and MongoDB (Preview).
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="mongodb://localhost:27017/users?replicaSet=rs0&directConnection=true"

# Endereço do servidor gRPC (padrão 0.0.0.0:50052)
GRPC_ADDRESS="0.0.0.0:50052"
# Porta do servidor HTTP auxiliar com /health e /ready (padrão 3334)
HTTP_PORT=3334
# Nível de log do pino: trace, debug, info, warn, error, fatal (padrão: debug em dev, info em production)
LOG_LEVEL="debug"

# Tempo máximo de cada verificação do /health, em ms (padrão 2000)
HEALTH_CHECK_TIMEOUT_MS=2000
